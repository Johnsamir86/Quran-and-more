{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["APP_BASE_URL", "CLIENT_ID", "CLIENT_SECRET", "SESSION_SECRET", "SCOPES", "TRANSLATION_IDS", "DEFAULT_READER_CHAPTER", "OAUTH2_BASE_URL", "GATEWAY_URL", "CONTENT_SCOPE_MODE", "DATABASE_URL", "REDIS_URL"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
