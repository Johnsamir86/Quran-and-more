PORT=3000
APP_BASE_URL=http://localhost:3000
CLIENT_ID=local_confidential_client_id
CLIENT_SECRET=local_confidential_client_secret
# Optional: separate OAuth2 client for user login + User APIs (if the developer
# console issued one when you enabled user login). Defaults to CLIENT_ID/SECRET.
# USER_CLIENT_ID=
# USER_CLIENT_SECRET=
SESSION_SECRET=local_dev_only_secret_change_me
SCOPES=openid offline_access user note collection bookmark goal preference post comment
TRANSLATION_IDS=131
DEFAULT_READER_CHAPTER=1

# Optional local stack endpoints
# Leave these commented to use the SDK production defaults. Uncomment only when
# running the Quran Foundation services locally.
# Prelive sandbox (surah 1 & 2 only):
# OAUTH2_BASE_URL=https://prelive-oauth2.quran.foundation
# GATEWAY_URL=https://apis-prelive.quran.foundation
# Production:
# OAUTH2_BASE_URL=https://oauth2.quran.foundation
# GATEWAY_URL=https://apis.quran.foundation
# Granular content scopes (required for clients created after the scope split):
CONTENT_SCOPE_MODE=granular
# OAUTH2_BASE_URL=http://localhost:5444
# TOKEN_HOST=http://localhost:5444
# AUTH_BASE_URL=http://localhost:3001
# CONTENT_BASE_URL=http://localhost:3020
# SEARCH_BASE_URL=http://localhost:3002
# QURAN_REFLECT_BASE_URL=http://localhost:9000
# GATEWAY_URL=http://localhost:5443

# Optional local Redis
# REDIS_URL=redis://localhost:6379

# Azan web push notifications (optional). Generate a VAPID key pair with
#   npx web-push generate-vapid-keys
# and set the same values in Netlify → Site configuration → Environment variables.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-site.netlify.app
# Shared secret the scheduled function netlify/functions/azan-tick.mts uses to call /api/azan/tick
# CRON_SECRET=

# Accounts (optional): Supabase project for Apple / Google / email sign-in and family sync
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
