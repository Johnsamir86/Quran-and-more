# Base URL of the apps/web backend the mobile app talks to.
# Local: http://<your-mac-lan-ip>:3000  (phones cannot reach "localhost")
# Staging: https://<netlify-subdomain>.netlify.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Comma-separated translation ids (85 on prelive, 131 on production)
EXPO_PUBLIC_TRANSLATION_IDS=85
